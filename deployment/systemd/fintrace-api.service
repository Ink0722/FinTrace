[Unit]
Description=FinTrace internal API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fintrace
Group=fintrace
WorkingDirectory=/workspace/fintrace
EnvironmentFile=/etc/fintrace/fintrace.env
ExecStartPre=/workspace/fintrace/.venv/bin/python -m deployment.bootstrap_showcase --seed /workspace/fintrace/deployment/assets/fintrace-showcase-seed.sqlite3 --runtime /workspace/fintrace/runtime/fintrace.sqlite3
ExecStart=/workspace/fintrace/.venv/bin/uvicorn app.api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
