[Unit]
Description=FinTrace showcase frontend
After=network-online.target fintrace-api.service
Wants=network-online.target

[Service]
Type=simple
User=fintrace
Group=fintrace
WorkingDirectory=/workspace/fintrace/fintrace-frontend
EnvironmentFile=/etc/fintrace/fintrace.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
