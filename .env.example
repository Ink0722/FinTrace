# Either QWEN_API_KEY or DASHSCOPE_API_KEY is accepted.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Either QWEN_MODEL or QWEN_CHAT_MODEL is accepted.
QWEN_MODEL=qwen3.7-max-2026-05-20
QWEN_CHAT_MODEL=qwen3.7-max-2026-05-20
# Optional completion ceiling for the final-answer model. Omit to use the provider default.
QWEN_MAX_OUTPUT_TOKENS=4096

# Optional: use a separate cheaper/faster model for routing and planning.
# If planner key is empty, FinTrace falls back to the rule planner.
QWEN_PLANNER_API_KEY=
DASHSCOPE_PLANNER_API_KEY=
QWEN_PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PLANNER_MODEL=qwen3.7-max-2026-05-20
# Independent ceiling for parser/planner/reviewer/repair/memory calls.
QWEN_PLANNER_MAX_OUTPUT_TOKENS=2048

# Document embedding: Batch File for offline indexing, synchronous API for queries.
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_CHUNKS_PER_SHARD=20000
EMBEDDING_BATCH_COMPLETION_WINDOW=24h
EMBEDDING_BATCH_POLL_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=5

# Online document retrieval. Relative paths are resolved from the project root.
FINTRACE_KB_PATH=data/indexes/document_search/fintrace_kb.sqlite
# Offline BM25 FTS5 lexical index built from the knowledge base (required for bm25/hybrid modes).
FINTRACE_BM25_INDEX_PATH=data/indexes/document_search/bm25_index.sqlite
FINTRACE_DOCUMENT_SEARCH_DEMO_MODE=false
FINTRACE_DOCUMENT_SEARCH_DEFAULT_MODE=hybrid
FINTRACE_DOCUMENT_SEARCH_DEFAULT_TOP_K=8
FINTRACE_DOCUMENT_SEARCH_MAX_TOP_K=20
FINTRACE_DOCUMENT_SEARCH_MAX_POOL_K=500
FINTRACE_DOCUMENT_SEARCH_RRF_K=60
FINTRACE_DOCUMENT_SEARCH_MAX_CHUNKS_PER_DOCUMENT=3
FINTRACE_DOCUMENT_SEARCH_EXACT_BATCH_SIZE=4096

# Structured shareholder holdings and the derived online query index.
FINTRACE_OWNERSHIP_NORMALIZED_DIR=data/normalized
FINTRACE_OWNERSHIP_INDEX_PATH=data/indexes/ownership_analysis/ownership_holdings.sqlite
FINTRACE_ENTITY_INDEX_PATH=data/indexes/entity_resolution/entity_master.sqlite

# Structured financial statements and the derived online query index.
FINTRACE_FINANCIAL_NORMALIZED_DIR=data/normalized
FINTRACE_FINANCIAL_INDEX_PATH=data/indexes/financial_analysis/financial_metrics.sqlite

# Announcement-derived event timeline index.
FINTRACE_EVENT_NORMALIZED_DIR=data/normalized
FINTRACE_EVENT_INDEX_PATH=data/indexes/event_timeline/events.sqlite

# Structured, attributed research-report views and their frozen Chunk source.
FINTRACE_RESEARCH_SOURCE_PATH=data/normalized/research_reports.jsonl
FINTRACE_RESEARCH_CHUNKS_PATH=data/processed/documents/chunks_v2.jsonl
FINTRACE_RESEARCH_INDEX_PATH=data/indexes/research_analysis/research_views.sqlite

# Company alias index for entity resolution (built offline, no default-company fallback).
FINTRACE_ENTITY_ALIAS_INDEX_PATH=data/indexes/entity_alias/company_aliases.sqlite

# Unified mutable runtime state: sessions, users, traces and evaluation batches.
FINTRACE_RUNTIME_DB=runtime/fintrace.sqlite3

# Optional knowledge cutoff (YYYY-MM-DD) injected by the workflow, never by the planner.
FINTRACE_KNOWLEDGE_CUTOFF=2026-05-28

APP_ENV=local
FINTRACE_EVAL_LOG_ENABLED=true
DATA_DIR=./data
