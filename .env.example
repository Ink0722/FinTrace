# Either QWEN_API_KEY or DASHSCOPE_API_KEY is accepted.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Either QWEN_MODEL or QWEN_CHAT_MODEL is accepted.
QWEN_MODEL=qwen-plus
QWEN_CHAT_MODEL=qwen-plus

# Optional: use a separate cheaper/faster model for routing and planning.
# If planner key is empty, FinTrace falls back to the rule planner.
QWEN_PLANNER_API_KEY=
DASHSCOPE_PLANNER_API_KEY=
QWEN_PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PLANNER_MODEL=qwen-plus

# Optional: document embedding for FAISS vector index.
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=16

# Optional: structured ownership graph data.
OWNERSHIP_DATA_SOURCE=auto
OWNERSHIP_ENTITIES_PATH=data/ownership/entities.csv
OWNERSHIP_RELATIONS_PATH=data/ownership/relations.csv

# Optional: structured financial records.
FINANCIAL_DATA_SOURCE=auto
FINANCIAL_RECORDS_PATH=data/financial/financial_records.csv

# Optional: structured event timeline records.
EVENT_DATA_SOURCE=auto
EVENTS_PATH=data/events/events.csv

APP_ENV=local
TRACE_PATH=./evaluation/reports/traces.jsonl
DATA_DIR=./data
